# 1. Base: same Python 3.10-slim
FROM python:3.10-slim

# 2. Patch OS libraries
RUN apt-get update && \
    apt-get upgrade -y && \
    rm -rf /var/lib/apt/lists/*

# 3. Install build deps (for pysam, scikit-allel, etc.)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libbz2-dev \
    liblzma-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 4. Create non-root user 'vscode'
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=$USER_UID
RUN groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID -m $USERNAME

USER $USERNAME
WORKDIR /home/$USERNAME/app

# 5. Copy requirements & install Python deps
COPY --chown=$USERNAME:$USERNAME requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 6. Copy the entire project into the container
COPY --chown=$USERNAME:$USERNAME . .

# 7. Default to an interactive shell (let VS Code open a terminal here)
CMD ["bash"]
