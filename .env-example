# NophiGene Version 2 development configuration.
# Production secrets are mounted as Docker secrets by scripts/start-v2.ps1.
# Never put database keys, session tokens, private sample paths, or provider
# credentials in this file or the repository.

NOPHIGENE_LOG_LEVEL=INFO
NOPHIGENE_ENABLE_LOCAL_EXTRACTION=0

# Development only. Production sets this to 1 in docker-compose.yml.
NOPHIGENE_REQUIRE_ENCRYPTION=0
NOPHIGENE_DATABASE_PATH=results/nophigene-v2.db

# Model and DANDELION development paths. Production containers use restricted
# mounts and Docker secrets configured by the launcher.
NOPHIGENE_MODEL_RUNNER_KEY_FILE=
NOPHIGENE_MODEL_CREDENTIAL_KEY_FILE=
NOPHIGENE_MODEL_WORK_ROOT=
NOPHIGENE_MODEL_CREDENTIAL_ROOT=
NOPHIGENE_MODEL_ARTIFACT_ROOT=
NOPHIGENE_HG38_REFERENCE_FASTA=
NOPHIGENE_DANDELION_IMPORT_ROOT=data/dandelion
NOPHIGENE_DANDELION_WORK_ROOT=results/dandelion
NOPHIGENE_DANDELION_RUNNER_KEY_FILE=
NOPHIGENE_DANDELION_ARTIFACT_KEY_FILE=

# Optional TLS trust configuration.
NOPHIGENE_CA_BUNDLE=
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=

# NCBI asks API users to identify their tool and email address.
NOPHIGENE_NCBI_TOOL=NophiGeneEvidenceWorkbench
NOPHIGENE_NCBI_EMAIL=your.email@example.org
NOPHIGENE_NCBI_API_KEY=

# Optional credentialed vetted sources. Keep credentials in the runtime secret
# mechanism or session memory; values shown here must remain empty.
NOPHIGENE_SOURCE_BIOGRID_TOKEN=
NOPHIGENE_SOURCE_PHARMGKB_TOKEN=
NOPHIGENE_SOURCE_ALPHAGENOME_TOKEN=

# External transfer still requires exact-payload confirmation and per-run
# consent even when a provider credential is available.
